{
  "name": "cortex",
  "version": "1.0.0",
  "description": "Cortex — A second brain and productivity desktop app",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/all.js",
    "dev": "electron . --dev",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "notes",
    "second-brain",
    "productivity",
    "markdown",
    "electron"
  ],
  "author": "Cortex",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.cortex.app",
    "productName": "Cortex",
    "win": {
      "target": "portable",
      "icon": "src/assets/icon.png"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/**/*"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  },
  "dependencies": {
    "marked": "18.1.1"
  }
}
